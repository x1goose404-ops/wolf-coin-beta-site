# Wolf Coin BETA — environment variables (NO secrets)
#
# The site is fully static; it needs no server env at runtime. These vars are optional
# build/deploy knobs. NEVER put private keys, seed phrases or signer JSON here.

# --- network (defaults live in config.js; only override if you self-host an RPC) ---
X1_RPC_MAINNET=https://rpc.mainnet.x1.xyz
X1_RPC_TESTNET=https://rpc.testnet.x1.xyz

# --- live mode gate ---
# false (default) => all actions are RPC-simulated only. Set true ONLY for an
# authorized live beta with funded, real XNT. Requires explicit human authorization.
WOLF_LIVE=false

# --- wallet metadata CDN base (must match the reviewed program's hardcoded URI base) ---
WOLF_METADATA_BASE=https://cdn.jsdelivr.net/gh/x1goose404-ops/wolfcoin-metadata@v1/metadata/
